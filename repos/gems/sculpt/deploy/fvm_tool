<config arch="">
	<common_routes>
		<service name="ROM" label_last="ld.lib.so"> <parent/> </service>
		<service name="CPU">   <parent/> </service>
		<service name="PD">    <parent/> </service>
		<service name="LOG">   <parent/> </service>
		<service name="Timer"> <parent/> </service>
	</common_routes>

	<start name="fonts_fs" pkg="fonts_fs">
		<route>
			<service name="ROM" label="config">
				<parent label="config -> managed/fonts"/>
			</service>
		</route>
	</start>
	<start name="themed_wm" pkg="themed_wm">
		<route>
			<service name="Gui" label="focus">
				<parent label="focus"/>
			</service>
			<service name="Gui">
				<parent/>
			</service>
			<service name="Report" label_last="shape">
				<parent/>
			</service>
			<service name="Report" label_last="clipboard">
				<parent/>
			</service>
			<service name="ROM" label_last="clipboard">
				<parent/>
			</service>
		</route>
	</start>
	<start name="recall_fs" pkg="recall_fs">
		<route>
			<service name="File_system">
				<child name="default_fs_rw"/>
			</service>
		</route>
	</start>
</config>
