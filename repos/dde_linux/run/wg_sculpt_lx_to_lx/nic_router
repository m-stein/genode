<config verbose_domain_state="yes">

	<report interval_sec="5" bytes="yes" config="yes" config_triggers="yes"/>


	<!--
	  -- Virtual peer 1 contains guest linux 1 that may access only
	  -- virtual peer 2 and only through the UDP tunnel of wireguard 1.
	  -->

	<policy label="wg_1 -> nic_session"    domain="peer1_outer_downlink"/>
	<policy label="wg_1 -> uplink_session" domain="peer1_inner_uplink"/>
	<policy label_prefix="vbox5_lx1 -> "   domain="peer1_inner_downlink"/>

	<domain name="peer1_outer_downlink" interface="10.1.2.1/24" verbose_packets="yes">
		<dhcp-server ip_first="10.1.2.2" ip_last="10.1.2.2"/>
		<udp-forward port="49002" domain="peer2_outer_downlink" to="10.2.2.2"/>
	</domain>

	<domain name="peer1_inner_uplink" interface="10.0.9.1/24" use_arp="no"  verbose_packets="yes">
		<nat domain="peer1_inner_downlink" tcp-ports="1000" icmp-ids="1000"/>
	</domain>

	<domain name="peer1_inner_downlink" interface="10.1.3.1/24" verbose_packets="yes">
		<dhcp-server ip_first="10.1.3.2" ip_last="10.1.3.2"/>
		<icmp dst="10.0.9.2/24" domain="peer1_inner_uplink"/>
		<tcp dst="10.0.9.2/24"><permit port="80" domain="peer1_inner_uplink"/></tcp>
	</domain>


	<!--
	  -- Virtual peer 2 contains guest linux 2 that may access only
	  -- virtual peer 1 and only through the UDP tunnel of wireguard 2.
	  -->

	<policy label="wg_2 -> nic_session"    domain="peer2_outer_downlink"/>
	<policy label="wg_2 -> uplink_session" domain="peer2_inner_uplink"/>
	<policy label_prefix="vbox5_lx2 -> "   domain="peer2_inner_downlink"/>

	<domain name="peer2_outer_downlink" interface="10.2.2.1/24" verbose_packets="yes">
		<dhcp-server ip_first="10.2.2.2" ip_last="10.2.2.2"/>
	</domain>

	<domain name="peer2_inner_uplink" interface="10.0.9.2/24" use_arp="no" icmp_echo_server="yes" verbose_packets="yes">
		<tcp-forward port="80" domain="peer2_inner_downlink" to="10.2.3.2"/>
	</domain>

	<domain name="peer2_inner_downlink" interface="10.2.3.1/24" verbose_packets="yes">
		<dhcp-server ip_first="10.2.3.2" ip_last="10.2.3.2"/>
	</domain>


	<!-- all other components may access the wlan -->

	<default-policy domain="default"/>

	<policy label="wifi_drv -> " domain="uplink"/>
	<domain name="uplink">
		<nat domain="default" tcp-ports="1000" udp-ports="1000" icmp-ids="1000"/>
	</domain>

	<domain name="default" interface="10.0.1.1/24">
		<dhcp-server ip_first="10.0.1.2" ip_last="10.0.1.200" dns_config_from="uplink"/>
		<tcp dst="0.0.0.0/0">
			<permit-any domain="uplink"/>
		</tcp>
		<udp dst="0.0.0.0/0">
			<permit-any domain="uplink"/>
		</udp>
		<icmp dst="0.0.0.0/0" domain="uplink"/>
	</domain>

</config>
