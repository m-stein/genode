From 26f981f17567ae36e7812ffccd77d6b20486c0e4 Mon Sep 17 00:00:00 2001
From: Martin Stein <martin.stein@genode-labs.com>
Date: Fri, 7 Jan 2022 16:25:52 +0100
Subject: [PATCH] wireguard: trace function calls and returns

---
 src/linux/drivers/net/wireguard/allowedips.c  |  85 ++++++++++++
 src/linux/drivers/net/wireguard/cookie.c      |  27 ++++
 src/linux/drivers/net/wireguard/device.c      |  35 +++++
 src/linux/drivers/net/wireguard/main.c        |  36 +++++-
 src/linux/drivers/net/wireguard/messages.h    |  31 +++++
 src/linux/drivers/net/wireguard/netlink.c     |  52 ++++++++
 src/linux/drivers/net/wireguard/noise.c       |  84 ++++++++++++
 src/linux/drivers/net/wireguard/peer.c        |  38 ++++++
 src/linux/drivers/net/wireguard/peerlookup.c  |  47 +++----
 src/linux/drivers/net/wireguard/queueing.c    |  52 ++++----
 src/linux/drivers/net/wireguard/ratelimiter.c |  37 +++---
 src/linux/drivers/net/wireguard/receive.c     | 122 +++++++++---------
 src/linux/drivers/net/wireguard/send.c        |  86 ++++++------
 src/linux/drivers/net/wireguard/socket.c      | 100 +++++++-------
 src/linux/drivers/net/wireguard/timers.c      |  68 +++++-----
 15 files changed, 641 insertions(+), 259 deletions(-)

diff --git src/linux/drivers/net/wireguard/allowedips.c src/linux/drivers/net/wireguard/allowedips.c
index b7197e8..459367a 100644
--- src/linux/drivers/net/wireguard/allowedips.c
+++ src/linux/drivers/net/wireguard/allowedips.c
@@ -10,17 +10,20 @@ static struct kmem_cache *node_cache;
 
 static void swap_endian(u8 *dst, const u8 *src, u8 bits)
 {
+MTRACE_FUNC_CALL
 	if (bits == 32) {
 		*(u32 *)dst = be32_to_cpu(*(const __be32 *)src);
 	} else if (bits == 128) {
 		((u64 *)dst)[0] = be64_to_cpu(((const __be64 *)src)[0]);
 		((u64 *)dst)[1] = be64_to_cpu(((const __be64 *)src)[1]);
 	}
+MTRACE_FUNC_RETURN
 }
 
 static void copy_and_assign_cidr(struct allowedips_node *node, const u8 *src,
 				 u8 cidr, u8 bits)
 {
+MTRACE_FUNC_CALL
 	node->cidr = cidr;
 	node->bit_at_a = cidr / 8U;
 #ifdef __LITTLE_ENDIAN
@@ -29,29 +32,37 @@ static void copy_and_assign_cidr(struct allowedips_node *node, const u8 *src,
 	node->bit_at_b = 7U - (cidr % 8U);
 	node->bitlen = bits;
 	memcpy(node->bits, src, bits / 8U);
+MTRACE_FUNC_RETURN
 }
 
 static inline u8 choose(struct allowedips_node *node, const u8 *key)
 {
+MTRACE_FUNC_CALL
+MTRACE_FUNC_RETURN
 	return (key[node->bit_at_a] >> node->bit_at_b) & 1;
 }
 
 static void push_rcu(struct allowedips_node **stack,
 		     struct allowedips_node __rcu *p, unsigned int *len)
 {
+MTRACE_FUNC_CALL
 	if (rcu_access_pointer(p)) {
 		WARN_ON(IS_ENABLED(DEBUG) && *len >= 128);
 		stack[(*len)++] = rcu_dereference_raw(p);
 	}
+MTRACE_FUNC_RETURN
 }
 
 static void node_free_rcu(struct rcu_head *rcu)
 {
+MTRACE_FUNC_CALL
 	kmem_cache_free(node_cache, container_of(rcu, struct allowedips_node, rcu));
+MTRACE_FUNC_RETURN
 }
 
 static void root_free_rcu(struct rcu_head *rcu)
 {
+MTRACE_FUNC_CALL
 	struct allowedips_node *node, *stack[128] = {
 		container_of(rcu, struct allowedips_node, rcu) };
 	unsigned int len = 1;
@@ -61,10 +72,12 @@ static void root_free_rcu(struct rcu_head *rcu)
 		push_rcu(stack, node->bit[1], &len);
 		kmem_cache_free(node_cache, node);
 	}
+MTRACE_FUNC_RETURN
 }
 
 static void root_remove_peer_lists(struct allowedips_node *root)
 {
+MTRACE_FUNC_CALL
 	struct allowedips_node *node, *stack[128] = { root };
 	unsigned int len = 1;
 
@@ -74,40 +87,54 @@ static void root_remove_peer_lists(struct allowedips_node *root)
 		if (rcu_access_pointer(node->peer))
 			list_del(&node->peer_list);
 	}
+MTRACE_FUNC_RETURN
 }
 
 static unsigned int fls128(u64 a, u64 b)
 {
+MTRACE_FUNC_CALL
+MTRACE_FUNC_RETURN
 	return a ? fls64(a) + 64U : fls64(b);
 }
 
 static u8 common_bits(const struct allowedips_node *node, const u8 *key,
 		      u8 bits)
 {
+MTRACE_FUNC_CALL
 	if (bits == 32)
+	{
+MTRACE_FUNC_RETURN
 		return 32U - fls(*(const u32 *)node->bits ^ *(const u32 *)key);
+	}
 	else if (bits == 128)
+	{
+MTRACE_FUNC_RETURN
 		return 128U - fls128(
 			*(const u64 *)&node->bits[0] ^ *(const u64 *)&key[0],
 			*(const u64 *)&node->bits[8] ^ *(const u64 *)&key[8]);
+	}
+MTRACE_FUNC_RETURN
 	return 0;
 }
 
 static bool prefix_matches(const struct allowedips_node *node, const u8 *key,
 			   u8 bits)
 {
+MTRACE_FUNC_CALL
 	/* This could be much faster if it actually just compared the common
 	 * bits properly, by precomputing a mask bswap(~0 << (32 - cidr)), and
 	 * the rest, but it turns out that common_bits is already super fast on
 	 * modern processors, even taking into account the unfortunate bswap.
 	 * So, we just inline it like this instead.
 	 */
+MTRACE_FUNC_RETURN
 	return common_bits(node, key, bits) >= node->cidr;
 }
 
 static struct allowedips_node *find_node(struct allowedips_node *trie, u8 bits,
 					 const u8 *key)
 {
+MTRACE_FUNC_CALL
 	struct allowedips_node *node = trie, *found = NULL;
 
 	while (node && prefix_matches(node, key, bits)) {
@@ -117,6 +144,7 @@ static struct allowedips_node *find_node(struct allowedips_node *trie, u8 bits,
 			break;
 		node = rcu_dereference_bh(node->bit[choose(node, key)]);
 	}
+MTRACE_FUNC_RETURN
 	return found;
 }
 
@@ -124,6 +152,7 @@ static struct allowedips_node *find_node(struct allowedips_node *trie, u8 bits,
 static struct wg_peer *lookup(struct allowedips_node __rcu *root, u8 bits,
 			      const void *be_ip)
 {
+MTRACE_FUNC_CALL
 	/* Aligned so it can be passed to fls/fls64 */
 	u8 ip[16] __aligned(__alignof(u64));
 	struct allowedips_node *node;
@@ -140,6 +169,7 @@ static struct wg_peer *lookup(struct allowedips_node __rcu *root, u8 bits,
 			goto retry;
 	}
 	rcu_read_unlock_bh();
+MTRACE_FUNC_RETURN
 	return peer;
 }
 
@@ -147,6 +177,7 @@ static bool node_placement(struct allowedips_node __rcu *trie, const u8 *key,
 			   u8 cidr, u8 bits, struct allowedips_node **rnode,
 			   struct mutex *lock)
 {
+MTRACE_FUNC_CALL
 	struct allowedips_node *node = rcu_dereference_protected(trie, lockdep_is_held(lock));
 	struct allowedips_node *parent = NULL;
 	bool exact = false;
@@ -160,47 +191,62 @@ static bool node_placement(struct allowedips_node __rcu *trie, const u8 *key,
 		node = rcu_dereference_protected(parent->bit[choose(parent, key)], lockdep_is_held(lock));
 	}
 	*rnode = parent;
+MTRACE_FUNC_RETURN
 	return exact;
 }
 
 static inline void connect_node(struct allowedips_node **parent, u8 bit, struct allowedips_node *node)
 {
+MTRACE_FUNC_CALL
 	node->parent_bit_packed = (unsigned long)parent | bit;
 	rcu_assign_pointer(*parent, node);
+MTRACE_FUNC_RETURN
 }
 
 static inline void choose_and_connect_node(struct allowedips_node *parent, struct allowedips_node *node)
 {
+MTRACE_FUNC_CALL
 	u8 bit = choose(parent, node->bits);
 	connect_node(&parent->bit[bit], bit, node);
+MTRACE_FUNC_RETURN
 }
 
 static int add(struct allowedips_node __rcu **trie, u8 bits, const u8 *key,
 	       u8 cidr, struct wg_peer *peer, struct mutex *lock)
 {
+MTRACE_FUNC_CALL
 	struct allowedips_node *node, *parent, *down, *newnode;
 
 	if (unlikely(cidr > bits || !peer))
+	{
+MTRACE_FUNC_RETURN
 		return -EINVAL;
+	}
 
 	if (!rcu_access_pointer(*trie)) {
 		node = kmem_cache_zalloc(node_cache, GFP_KERNEL);
 		if (unlikely(!node))
+	{
+MTRACE_FUNC_RETURN
 			return -ENOMEM;
+	}
 		RCU_INIT_POINTER(node->peer, peer);
 		list_add_tail(&node->peer_list, &peer->allowedips_list);
 		copy_and_assign_cidr(node, key, cidr, bits);
 		connect_node(trie, 2, node);
+MTRACE_FUNC_RETURN
 		return 0;
 	}
 	if (node_placement(*trie, key, cidr, bits, &node, lock)) {
 		rcu_assign_pointer(node->peer, peer);
 		list_move_tail(&node->peer_list, &peer->allowedips_list);
+MTRACE_FUNC_RETURN
 		return 0;
 	}
 
 	newnode = kmem_cache_zalloc(node_cache, GFP_KERNEL);
 	if (unlikely(!newnode))
+MTRACE_FUNC_RETURN
 		return -ENOMEM;
 	RCU_INIT_POINTER(newnode->peer, peer);
 	list_add_tail(&newnode->peer_list, &peer->allowedips_list);
@@ -213,6 +259,7 @@ static int add(struct allowedips_node __rcu **trie, u8 bits, const u8 *key,
 		down = rcu_dereference_protected(node->bit[bit], lockdep_is_held(lock));
 		if (!down) {
 			connect_node(&node->bit[bit], bit, newnode);
+MTRACE_FUNC_RETURN
 			return 0;
 		}
 	}
@@ -225,6 +272,7 @@ static int add(struct allowedips_node __rcu **trie, u8 bits, const u8 *key,
 			connect_node(trie, 2, newnode);
 		else
 			choose_and_connect_node(parent, newnode);
+MTRACE_FUNC_RETURN
 		return 0;
 	}
 
@@ -232,6 +280,7 @@ static int add(struct allowedips_node __rcu **trie, u8 bits, const u8 *key,
 	if (unlikely(!node)) {
 		list_del(&newnode->peer_list);
 		kmem_cache_free(node_cache, newnode);
+MTRACE_FUNC_RETURN
 		return -ENOMEM;
 	}
 	INIT_LIST_HEAD(&node->peer_list);
@@ -243,17 +292,21 @@ static int add(struct allowedips_node __rcu **trie, u8 bits, const u8 *key,
 		connect_node(trie, 2, node);
 	else
 		choose_and_connect_node(parent, node);
+MTRACE_FUNC_RETURN
 	return 0;
 }
 
 void wg_allowedips_init(struct allowedips *table)
 {
+MTRACE_FUNC_CALL
 	table->root4 = table->root6 = NULL;
 	table->seq = 1;
+MTRACE_FUNC_RETURN
 }
 
 void wg_allowedips_free(struct allowedips *table, struct mutex *lock)
 {
+MTRACE_FUNC_CALL
 	struct allowedips_node __rcu *old4 = table->root4, *old6 = table->root6;
 
 	++table->seq;
@@ -273,38 +326,47 @@ void wg_allowedips_free(struct allowedips *table, struct mutex *lock)
 		root_remove_peer_lists(node);
 		call_rcu(&node->rcu, root_free_rcu);
 	}
+MTRACE_FUNC_RETURN
 }
 
 int wg_allowedips_insert_v4(struct allowedips *table, const struct in_addr *ip,
 			    u8 cidr, struct wg_peer *peer, struct mutex *lock)
 {
+MTRACE_FUNC_CALL
 	/* Aligned so it can be passed to fls */
 	u8 key[4] __aligned(__alignof(u32));
 
 	++table->seq;
 	swap_endian(key, (const u8 *)ip, 32);
+MTRACE_FUNC_RETURN
 	return add(&table->root4, 32, key, cidr, peer, lock);
 }
 
 int wg_allowedips_insert_v6(struct allowedips *table, const struct in6_addr *ip,
 			    u8 cidr, struct wg_peer *peer, struct mutex *lock)
 {
+MTRACE_FUNC_CALL
 	/* Aligned so it can be passed to fls64 */
 	u8 key[16] __aligned(__alignof(u64));
 
 	++table->seq;
 	swap_endian(key, (const u8 *)ip, 128);
+MTRACE_FUNC_RETURN
 	return add(&table->root6, 128, key, cidr, peer, lock);
 }
 
 void wg_allowedips_remove_by_peer(struct allowedips *table,
 				  struct wg_peer *peer, struct mutex *lock)
 {
+MTRACE_FUNC_CALL
 	struct allowedips_node *node, *child, **parent_bit, *parent, *tmp;
 	bool free_parent;
 
 	if (list_empty(&peer->allowedips_list))
+	{
+MTRACE_FUNC_RETURN
 		return;
+	}
 	++table->seq;
 	list_for_each_entry_safe(node, tmp, &peer->allowedips_list, peer_list) {
 		list_del_init(&node->peer_list);
@@ -335,10 +397,12 @@ void wg_allowedips_remove_by_peer(struct allowedips *table,
 		*(struct allowedips_node **)(parent->parent_bit_packed & ~3UL) = child;
 		call_rcu(&parent->rcu, node_free_rcu);
 	}
+MTRACE_FUNC_RETURN
 }
 
 int wg_allowedips_read_node(struct allowedips_node *node, u8 ip[16], u8 *cidr)
 {
+MTRACE_FUNC_CALL
 	const unsigned int cidr_bytes = DIV_ROUND_UP(node->cidr, 8U);
 	swap_endian(ip, node->bits, node->bitlen);
 	memset(ip + cidr_bytes, 0, node->bitlen / 8U - cidr_bytes);
@@ -346,6 +410,7 @@ int wg_allowedips_read_node(struct allowedips_node *node, u8 ip[16], u8 *cidr)
 		ip[cidr_bytes - 1U] &= ~0U << (-node->cidr % 8U);
 
 	*cidr = node->cidr;
+MTRACE_FUNC_RETURN
 	return node->bitlen == 32 ? AF_INET : AF_INET6;
 }
 
@@ -353,10 +418,18 @@ int wg_allowedips_read_node(struct allowedips_node *node, u8 ip[16], u8 *cidr)
 struct wg_peer *wg_allowedips_lookup_dst(struct allowedips *table,
 					 struct sk_buff *skb)
 {
+MTRACE_FUNC_CALL
 	if (skb->protocol == htons(ETH_P_IP))
+	{
+MTRACE_FUNC_RETURN
 		return lookup(table->root4, 32, &ip_hdr(skb)->daddr);
+	}
 	else if (skb->protocol == htons(ETH_P_IPV6))
+	{
+MTRACE_FUNC_RETURN
 		return lookup(table->root6, 128, &ipv6_hdr(skb)->daddr);
+	}
+MTRACE_FUNC_RETURN
 	return NULL;
 }
 
@@ -364,23 +437,35 @@ struct wg_peer *wg_allowedips_lookup_dst(struct allowedips *table,
 struct wg_peer *wg_allowedips_lookup_src(struct allowedips *table,
 					 struct sk_buff *skb)
 {
+MTRACE_FUNC_CALL
 	if (skb->protocol == htons(ETH_P_IP))
+	{
+MTRACE_FUNC_RETURN
 		return lookup(table->root4, 32, &ip_hdr(skb)->saddr);
+	}
 	else if (skb->protocol == htons(ETH_P_IPV6))
+	{
+MTRACE_FUNC_RETURN
 		return lookup(table->root6, 128, &ipv6_hdr(skb)->saddr);
+	}
+MTRACE_FUNC_RETURN
 	return NULL;
 }
 
 int __init wg_allowedips_slab_init(void)
 {
+MTRACE_FUNC_CALL
 	node_cache = KMEM_CACHE(allowedips_node, 0);
+MTRACE_FUNC_RETURN
 	return node_cache ? 0 : -ENOMEM;
 }
 
 void wg_allowedips_slab_uninit(void)
 {
+MTRACE_FUNC_CALL
 	rcu_barrier();
 	kmem_cache_destroy(node_cache);
+MTRACE_FUNC_RETURN
 }
 
 #include "selftest/allowedips.c"
diff --git src/linux/drivers/net/wireguard/cookie.c src/linux/drivers/net/wireguard/cookie.c
index 4956f04..55f9f8f 100644
--- src/linux/drivers/net/wireguard/cookie.c
+++ src/linux/drivers/net/wireguard/cookie.c
@@ -19,10 +19,12 @@
 void wg_cookie_checker_init(struct cookie_checker *checker,
 			    struct wg_device *wg)
 {
+MTRACE_FUNC_CALL
 	init_rwsem(&checker->secret_lock);
 	checker->secret_birthdate = ktime_get_coarse_boottime_ns();
 	get_random_bytes(checker->secret, NOISE_HASH_LEN);
 	checker->device = wg;
+MTRACE_FUNC_RETURN
 }
 
 enum { COOKIE_KEY_LABEL_LEN = 8 };
@@ -33,17 +35,20 @@ static void precompute_key(u8 key[NOISE_SYMMETRIC_KEY_LEN],
 			   const u8 pubkey[NOISE_PUBLIC_KEY_LEN],
 			   const u8 label[COOKIE_KEY_LABEL_LEN])
 {
+MTRACE_FUNC_CALL
 	struct blake2s_state blake;
 
 	blake2s_init(&blake, NOISE_SYMMETRIC_KEY_LEN);
 	blake2s_update(&blake, label, COOKIE_KEY_LABEL_LEN);
 	blake2s_update(&blake, pubkey, NOISE_PUBLIC_KEY_LEN);
 	blake2s_final(&blake, key);
+MTRACE_FUNC_RETURN
 }
 
 /* Must hold peer->handshake.static_identity->lock */
 void wg_cookie_checker_precompute_device_keys(struct cookie_checker *checker)
 {
+MTRACE_FUNC_CALL
 	if (likely(checker->device->static_identity.has_identity)) {
 		precompute_key(checker->cookie_encryption_key,
 			       checker->device->static_identity.static_public,
@@ -56,41 +61,51 @@ void wg_cookie_checker_precompute_device_keys(struct cookie_checker *checker)
 		       NOISE_SYMMETRIC_KEY_LEN);
 		memset(checker->message_mac1_key, 0, NOISE_SYMMETRIC_KEY_LEN);
 	}
+MTRACE_FUNC_RETURN
 }
 
 void wg_cookie_checker_precompute_peer_keys(struct wg_peer *peer)
 {
+MTRACE_FUNC_CALL
 	precompute_key(peer->latest_cookie.cookie_decryption_key,
 		       peer->handshake.remote_static, cookie_key_label);
 	precompute_key(peer->latest_cookie.message_mac1_key,
 		       peer->handshake.remote_static, mac1_key_label);
+MTRACE_FUNC_RETURN
 }
 
 void wg_cookie_init(struct cookie *cookie)
 {
+MTRACE_FUNC_CALL
 	memset(cookie, 0, sizeof(*cookie));
 	init_rwsem(&cookie->lock);
+MTRACE_FUNC_RETURN
 }
 
 static void compute_mac1(u8 mac1[COOKIE_LEN], const void *message, size_t len,
 			 const u8 key[NOISE_SYMMETRIC_KEY_LEN])
 {
+MTRACE_FUNC_CALL
 	len = len - sizeof(struct message_macs) +
 	      offsetof(struct message_macs, mac1);
 	blake2s(mac1, message, key, COOKIE_LEN, len, NOISE_SYMMETRIC_KEY_LEN);
+MTRACE_FUNC_RETURN
 }
 
 static void compute_mac2(u8 mac2[COOKIE_LEN], const void *message, size_t len,
 			 const u8 cookie[COOKIE_LEN])
 {
+MTRACE_FUNC_CALL
 	len = len - sizeof(struct message_macs) +
 	      offsetof(struct message_macs, mac2);
 	blake2s(mac2, message, cookie, COOKIE_LEN, len, COOKIE_LEN);
+MTRACE_FUNC_RETURN
 }
 
 static void make_cookie(u8 cookie[COOKIE_LEN], struct sk_buff *skb,
 			struct cookie_checker *checker)
 {
+MTRACE_FUNC_CALL
 	struct blake2s_state state;
 
 	if (wg_birthdate_has_expired(checker->secret_birthdate,
@@ -114,12 +129,14 @@ static void make_cookie(u8 cookie[COOKIE_LEN], struct sk_buff *skb,
 	blake2s_final(&state, cookie);
 
 	up_read(&checker->secret_lock);
+MTRACE_FUNC_RETURN
 }
 
 enum cookie_mac_state wg_cookie_validate_packet(struct cookie_checker *checker,
 						struct sk_buff *skb,
 						bool check_cookie)
 {
+MTRACE_FUNC_CALL
 	struct message_macs *macs = (struct message_macs *)
 		(skb->data + skb->len - sizeof(*macs));
 	enum cookie_mac_state ret;
@@ -150,12 +167,14 @@ enum cookie_mac_state wg_cookie_validate_packet(struct cookie_checker *checker,
 	ret = VALID_MAC_WITH_COOKIE;
 
 out:
+MTRACE_FUNC_RETURN
 	return ret;
 }
 
 void wg_cookie_add_mac_to_packet(void *message, size_t len,
 				 struct wg_peer *peer)
 {
+MTRACE_FUNC_CALL
 	struct message_macs *macs = (struct message_macs *)
 		((u8 *)message + len - sizeof(*macs));
 
@@ -175,12 +194,14 @@ void wg_cookie_add_mac_to_packet(void *message, size_t len,
 	else
 		memset(macs->mac2, 0, COOKIE_LEN);
 	up_read(&peer->latest_cookie.lock);
+MTRACE_FUNC_RETURN
 }
 
 void wg_cookie_message_create(struct message_handshake_cookie *dst,
 			      struct sk_buff *skb, __le32 index,
 			      struct cookie_checker *checker)
 {
+MTRACE_FUNC_CALL
 	struct message_macs *macs = (struct message_macs *)
 		((u8 *)skb->data + skb->len - sizeof(*macs));
 	u8 cookie[COOKIE_LEN];
@@ -193,11 +214,13 @@ void wg_cookie_message_create(struct message_handshake_cookie *dst,
 	xchacha20poly1305_encrypt(dst->encrypted_cookie, cookie, COOKIE_LEN,
 				  macs->mac1, COOKIE_LEN, dst->nonce,
 				  checker->cookie_encryption_key);
+MTRACE_FUNC_RETURN
 }
 
 void wg_cookie_message_consume(struct message_handshake_cookie *src,
 			       struct wg_device *wg)
 {
+MTRACE_FUNC_CALL
 	struct wg_peer *peer = NULL;
 	u8 cookie[COOKIE_LEN];
 	bool ret;
@@ -206,7 +229,10 @@ void wg_cookie_message_consume(struct message_handshake_cookie *src,
 						INDEX_HASHTABLE_HANDSHAKE |
 						INDEX_HASHTABLE_KEYPAIR,
 						src->receiver_index, &peer)))
+	{
+MTRACE_FUNC_RETURN
 		return;
+	}
 
 	down_read(&peer->latest_cookie.lock);
 	if (unlikely(!peer->latest_cookie.have_sent_mac1)) {
@@ -233,4 +259,5 @@ void wg_cookie_message_consume(struct message_handshake_cookie *src,
 
 out:
 	wg_peer_put(peer);
+MTRACE_FUNC_RETURN
 }
diff --git src/linux/drivers/net/wireguard/device.c src/linux/drivers/net/wireguard/device.c
index 551ddaa..e63a33d 100644
--- src/linux/drivers/net/wireguard/device.c
+++ src/linux/drivers/net/wireguard/device.c
@@ -28,6 +28,7 @@ static LIST_HEAD(device_list);
 
 static int wg_open(struct net_device *dev)
 {
+MTRACE_FUNC_CALL
 	struct in_device *dev_v4 = __in_dev_get_rtnl(dev);
 	struct inet6_dev *dev_v6 = __in6_dev_get(dev);
 	struct wg_device *wg = netdev_priv(dev);
@@ -56,6 +57,7 @@ static int wg_open(struct net_device *dev)
 	}
 out:
 	mutex_unlock(&wg->device_update_lock);
+MTRACE_FUNC_RETURN
 	return ret;
 }
 
@@ -63,6 +65,7 @@ static int wg_open(struct net_device *dev)
 static int wg_pm_notification(struct notifier_block *nb, unsigned long action,
 			      void *data)
 {
+MTRACE_FUNC_CALL
 	struct wg_device *wg;
 	struct wg_peer *peer;
 
@@ -71,10 +74,16 @@ static int wg_pm_notification(struct notifier_block *nb, unsigned long action,
 	 * don't actually want to clear keys.
 	 */
 	if (IS_ENABLED(CONFIG_PM_AUTOSLEEP) || IS_ENABLED(CONFIG_ANDROID))
+	{
+MTRACE_FUNC_RETURN
 		return 0;
+	}
 
 	if (action != PM_HIBERNATION_PREPARE && action != PM_SUSPEND_PREPARE)
